<?xml version='1.0' encoding='utf-8'?>
<robot name="openarm_omnihand">
  <group name="right_arm">
    <chain base_link="openarm_right_link0" tip_link="tool_tcp" />
  </group>
  <group_state name="initial_start" group="right_arm">
    <joint name="openarm_right_joint1" value="0.15" />
    <joint name="openarm_right_joint2" value="0.15" />
    <joint name="openarm_right_joint3" value="-0.15" />
    <joint name="openarm_right_joint4" value="0.15" />
    <joint name="openarm_right_joint5" value="0.1" />
    <joint name="openarm_right_joint6" value="-0.1" />
    <joint name="openarm_right_joint7" value="0.1" />
  </group_state>
  <group_state name="zero" group="right_arm">
    <joint name="openarm_right_joint1" value="0.0" />
    <joint name="openarm_right_joint2" value="0.0" />
    <joint name="openarm_right_joint3" value="0.0" />
    <joint name="openarm_right_joint4" value="0.0" />
    <joint name="openarm_right_joint5" value="0.0" />
    <joint name="openarm_right_joint6" value="0.0" />
    <joint name="openarm_right_joint7" value="0.0" />
  </group_state>
  <group_state name="reference" group="right_arm">
    <joint name="openarm_right_joint1" value="0" />
    <joint name="openarm_right_joint2" value="0" />
    <joint name="openarm_right_joint3" value="0" />
    <joint name="openarm_right_joint4" value="0.01" />
    <joint name="openarm_right_joint5" value="0" />
    <joint name="openarm_right_joint6" value="0" />
    <joint name="openarm_right_joint7" value="0" />
  </group_state>
  <disable_collisions link1="openarm_right_link1" link2="openarm_right_link2" reason="articulated_mount_interface_source_overlap" />
  <disable_collisions link1="openarm_right_link2" link2="openarm_right_link3" reason="articulated_mount_interface_source_overlap" />
  <disable_collisions link1="openarm_right_link3" link2="openarm_right_link4" reason="articulated_mount_interface_source_overlap" />
